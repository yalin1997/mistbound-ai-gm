# Node 24+, copy to .env, never commit credentials.
PORT=3001
HOST=0.0.0.0
DB_PATH=./data/game.sqlite
# Browser origin when using a reverse proxy. Default accepts same-origin only.
# PUBLIC_ORIGIN=https://your-game.example
# COOKIE_SECURE=true
# Without a key, the server clearly reports rules-only mode.
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
AI_CALL_LIMIT=100
# Includes all prompt and maximum completion tokens reserved per request.
AI_TOKEN_BUDGET=300000
DISCONNECT_GRACE_MS=60000
